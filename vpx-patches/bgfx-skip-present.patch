--- a/src/glcontext_egl.cpp
+++ b/src/glcontext_egl.cpp
@@ -946,6 +946,21 @@
 		bx::deleteObject(g_allocator, _swapChain);
 	}
 
+	// FORK PATCH (4kp): let the embedder present every surface itself.
+	//
+	// eglSwapBuffers blocks until the whole context's GPU work has drained, not merely the work
+	// targeting the surface being swapped -- so it serialises the frame no matter WHICH surface it
+	// names. Skipping only the primary just moves the wait into the next swap chain. When something
+	// else owns presentation -- here VPX renders into its own scanout buffers and commits them
+	// through KMS with an IN_FENCE_FD -- every one of these calls is pure cost.
+	//
+	// Measured on RK3588: 17 ms of a 25 ms frame, with the GPU idle for the remainder.
+	//
+	// This is the bgfx-side counterpart of SDL_KMSDRM_SKIP_EGL_SURFACE, which already stops SDL owning
+	// presentation for this surface. Runtime rather than compile time, so the first frames (before the
+	// embedder's buffers exist) and any fallback still present normally.
+	bool s_skipPresent = false;
+
 	void GlContext::swap(SwapChainGL* _swapChain)
 	{
 		makeCurrent(_swapChain);
@@ -953,12 +968,13 @@
 		if (NULL == _swapChain)
 		{
 			if (NULL != m_display
-			&&  EGL_NO_SURFACE != m_surface)
+			&&  EGL_NO_SURFACE != m_surface
+			&&  !s_skipPresent)
 			{
 				EGL_CHECK(eglSwapBuffers(m_display, m_surface) );
 			}
 		}
-		else
+		else if (!s_skipPresent)
 		{
 			_swapChain->swapBuffers();
 		}
@@ -1050,5 +1066,12 @@
 
 } /* namespace gl */ } // namespace bgfx
 
+// FORK PATCH (4kp): see s_skipPresent above. C linkage so the embedder can flip it without
+// linking against bgfx internals.
+extern "C" void bgfx_set_skip_present(bool _skip)
+{
+	bgfx::gl::s_skipPresent = _skip;
+}
+
 #	endif // BGFX_USE_EGL
 #endif // (BGFX_CONFIG_RENDERER_OPENGLES || BGFX_CONFIG_RENDERER_OPENGL)
