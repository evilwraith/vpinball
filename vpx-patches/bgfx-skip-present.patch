+	// FORK PATCH (4kp): let the embedder present every surface itself.
+	//
+	// eglSwapBuffers blocks until the whole context's GPU work has drained, not merely the work
+	// targeting the surface being swapped -- so it serialises the frame no matter WHICH surface it
+	// names. Skipping only the primary just moves the wait into the next swap chain. When something
+	// else owns presentation -- here VPX renders into its own scanout buffers and commits them
+	// through KMS with an IN_FENCE_FD -- every one of these calls is pure cost.
+	//
+	// Part two: while presentation is skipped, keep the context current on a 1x1 PBUFFER instead
+	// of the window surface. A window surface that is current but never swapped puts this driver
+	// (libmali Valhall) on a slow path: GL encode inflated from ~5 ms to ~21 ms per frame across
+	// every render pass (measured on the HDP, 2026-08-30, same-binary A/B). A pbuffer is
+	// single-buffered, needs no swap, and stays clear of the gbm surface's buffer state --
+	// rebinding the window surface to EGL_NO_SURFACE instead hung this driver for 11 seconds and
+	// took the process down, so surfaceless is NOT used. Every step here fails safe: any error
+	// leaves the window surface bound and only costs the slow path.
+	bool s_skipPresent = false;
+	static EGLSurface s_idleSurface = EGL_NO_SURFACE;
+	static bool s_idleSurfaceTried = false;
+	static bool s_boundIdle = false;
+
 	void GlContext::swap(SwapChainGL* _swapChain)
 	{
 		makeCurrent(_swapChain);
 
 		if (NULL == _swapChain)
 		{
+			if (s_skipPresent != s_boundIdle
+			&&  NULL != m_display)
+			{
+				if (s_skipPresent && !s_idleSurfaceTried)
+				{
+					s_idleSurfaceTried = true;
+					EGLint surfaceType = 0;
+					eglGetConfigAttrib(m_display, m_config, EGL_SURFACE_TYPE, &surfaceType);
+					if (0 != (surfaceType & EGL_PBUFFER_BIT) )
+					{
+						const EGLint pbAttrs[] = { EGL_WIDTH, 1, EGL_HEIGHT, 1, EGL_NONE };
+						s_idleSurface = eglCreatePbufferSurface(m_display, m_config, pbAttrs);
+					}
+					fprintf(stderr, "[4kp] bgfx skip-present idle pbuffer: %s (surfaceType 0x%x)\n"
+						, EGL_NO_SURFACE != s_idleSurface ? "created" : "UNAVAILABLE -- staying on the window surface (slow path)"
+						, surfaceType);
+				}
+				if (!s_skipPresent || EGL_NO_SURFACE != s_idleSurface)
+				{
+					const EGLSurface draw = s_skipPresent ? s_idleSurface : m_surface;
+					const EGLSurface read = s_skipPresent ? s_idleSurface : m_readSurface;
+					if (EGL_TRUE == eglMakeCurrent(m_display, draw, read, m_context) )
+					{
+						s_boundIdle = s_skipPresent;
+					}
+					else
+					{
+						fprintf(stderr, "[4kp] bgfx skip-present rebind FAILED (egl 0x%x); keeping current binding\n"
+							, eglGetError() );
+					}
+				}
+			}
+
 			if (NULL != m_display
-			&&  EGL_NO_SURFACE != m_surface)
+			&&  EGL_NO_SURFACE != m_surface
+			&&  !s_skipPresent
+			&&  !s_boundIdle)
 			{
 				EGL_CHECK(eglSwapBuffers(m_display, m_surface) );
 			}
 		}
-		else
+		else if (!s_skipPresent)
 		{
 			_swapChain->swapBuffers();
 		}
@@ -974,7 +1031,12 @@
 			{
 				if (NULL != m_display)
 				{
-					EGL_CHECK(eglMakeCurrent(m_display, m_surface, m_readSurface, m_context) );
+					// FORK PATCH (4kp): honour the idle-pbuffer mode; see s_boundIdle above.
+					EGL_CHECK(eglMakeCurrent(m_display
+						, s_boundIdle ? s_idleSurface : m_surface
+						, s_boundIdle ? s_idleSurface : m_readSurface
+						, m_context
+						) );
 				}
 			}
 			else
@@ -1050,5 +1112,12 @@
 
 } /* namespace gl */ } // namespace bgfx
 
