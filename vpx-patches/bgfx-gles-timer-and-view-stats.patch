 			m_gpuTimer.end(frameQueryIdx);
@@ -8944,6 +8985,23 @@
 		perfStats.numBlit       = _render->m_numBlitItems;
 		perfStats.maxGpuLatency = maxGpuLatency;
 		perfStats.gpuFrameNum   = result.m_frameNum;
+		perfStats.numViews      = 0;
+		for (uint32_t ii = 0; ii < numTimedViews && perfStats.numViews < BGFX_CONFIG_MAX_VIEWS; ++ii)
+		{
+			const uint16_t viewId = timedViewIds[ii];
+			const TimerQueryGL::Result& viewResult = m_gpuTimer.m_result[viewId];
+			if (0 == viewResult.m_frameNum)
+			{
+				continue; // never completed a query yet
+			}
+			ViewStats& viewStats = perfStats.viewStats[perfStats.numViews++];
+			viewStats.view         = ViewId(viewId);
+			viewStats.gpuTimeBegin = viewResult.m_begin;
+			viewStats.gpuTimeEnd   = viewResult.m_end;
+			viewStats.gpuFrameNum  = viewResult.m_frameNum;
+			bx::strCopy(viewStats.name, sizeof(viewStats.name), s_viewName[viewId]);
+		}
+		BX_UNUSED(timedView);
 		bx::memCopy(perfStats.numPrims, statsNumPrimsRendered, sizeof(perfStats.numPrims) );
 		perfStats.gpuMemoryMax  = -INT64_MAX;
