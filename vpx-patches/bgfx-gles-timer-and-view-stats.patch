+		// one render pass, forcing a tile flush and reload at every boundary. Measured on Mali-G610
+		// that turned a 26 ms frame into multi-second stalls. Round-robin gives the same attribution
+		// over a handful of frames, which is what a profiler averages over anyway.
+		// (function statics, matching maxGpuLatency below: submit() has a single render thread)
+		static uint32_t s_viewCursor = 0;
+		static uint32_t s_viewPublished[BGFX_CONFIG_MAX_VIEWS] = {};
+		const uint32_t timedViewSlot = s_viewCursor;
+		uint32_t viewQueryIdx = UINT32_MAX;
+		uint32_t numViewRuns = 0;
