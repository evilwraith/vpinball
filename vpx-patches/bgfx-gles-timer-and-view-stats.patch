@@ -7942,6 +7951,32 @@
 					setViewType(view, "  ");
 					BGFX_GL_PROFILER_BEGIN(view, kColorView);
 
+					if (m_timerQuerySupport)
+					{
+						if (UINT32_MAX != viewQueryIdx)
+						{
+							m_gpuTimer.end(viewQueryIdx);
+							viewQueryIdx = UINT32_MAX;
+						}
+						// One timed span per view id. A view submitted in several runs would otherwise
+						// overwrite its own result; keeping the first run is enough to attribute cost.
+						bool alreadyTimed = false;
+						for (uint32_t ii = 0; ii < numTimedViews; ++ii)
+						{
+							if (timedViewIds[ii] == view)
+							{
+								alreadyTimed = true;
+								break;
+							}
+						}
+						if (!alreadyTimed && numTimedViews < BX_COUNTOF(timedViewIds) )
+						{
+							timedViewIds[numTimedViews++] = view;
+							timedView = view;
+							viewQueryIdx = m_gpuTimer.begin(view, _render->m_frameNum);
+						}
+					}
+
 					profiler.begin(view);
 
 					viewState.m_rect = _render->m_view[view].m_rect;
